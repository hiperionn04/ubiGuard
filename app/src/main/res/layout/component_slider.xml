<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_profile"
        android:contentDescription="@string/desc_menu_icon"
        app:tint="#00D0FF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A1A"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/menuDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_dashboard"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_profile"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuAlarms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_alarms"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_camera"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuSensors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_sensors"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_system_logs"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_logout"
        android:textColor="#FF3B30"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackground"/>
</LinearLayout>
