<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra Superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivMenuIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_profile"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logs_do_alarme"
                android:textColor="#00D0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:layout_marginEnd="32dp"/>
        </LinearLayout>

        <!-- Pedir o ID do Alarme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:background="#0A0A0A">

            <EditText
                android:id="@+id/etAlarmId"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/id_do_alarme"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A4A4A"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearchLogs"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button"
                android:text="@string/procurar"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista de Logs -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/progressBarLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:indeterminateTint="#00D0FF"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/id_do_alarme"
                android:textColor="#7A8B99"
                android:textSize="16sp"
                android:textAlignment="center"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                android:visibility="gone"/>
        </RelativeLayout>
    </LinearLayout>

    <include layout="@layout/component_slider" />

</androidx.drawerlayout.widget.DrawerLayout>